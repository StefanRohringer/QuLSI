# Ziel des Backups. Beispiele:
#   externe Platte:  /mnt/backup/qulsi
#   außer Haus:      sftp:user@host:/backup/qulsi   oder   s3:https://s3.example.com/bucket/qulsi
export RESTIC_REPOSITORY=/mnt/backup/qulsi
# Passwort sicher aufbewahren (Passwortmanager). Ohne es ist das Backup verloren.
export RESTIC_PASSWORD=bitte-aendern
