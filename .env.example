# Vorlage: kopieren nach .env und Werte eintragen.  cp .env.example .env
# Passwörter und Tokens der Connectoren gehören nicht hierher, sondern in den Tresor (README, Abschnitt Connector Hub).
# Geheimnisse erzeugen z. B. mit:  openssl rand -hex 24

TZ=Europe/Berlin
# Bundesland für die Feiertage (Kürzel: BW BY BE BB HB HH HE MV NI NW RP SL SN ST SH TH), leer = alle
QULSI_BUNDESLAND=
# Wie QuLSI dich nennt. Leer = QuLSI fragt nach (oder du sagst es ihr im Gespräch).
QULSI_NUTZER=
# Zugangsdaten und Konten in der App ändern (immer mit Freigabe). aus = nur noch auf der Kommandozeile.
QULSI_TRESOR_APP=an
# Aus welchen Netzen die App das darf (Standard: Heimnetz und Tailscale, also private Adressen)
# QULSI_TRESOR_NETZE=192.168.0.0/16,100.64.0.0/10

# --- Schlüssel (alle ändern!)
POSTGRES_PASSWORD=bitte-aendern
LITELLM_MASTER_KEY=sk-bitte-aendern
# Schlüssel für die QuLSI-App und alle Programme, die mit QuLSI sprechen
QULSI_API_KEY=bitte-aendern
# Freigabe-PIN für "Erlauben" in der App, nur als Hash. Setzen mit: scripts/freigabe-pin.sh
# Leer: Erlauben geht nur über die Knöpfe in der Handy-Benachrichtigung (ntfy).
QULSI_FREIGABE_PIN=
SEARXNG_SECRET=bitte-aendern
WEBUI_SECRET_KEY=bitte-aendern
# Eigene Datenbank-Rollen je Dienst (jeder sieht nur seine Tabellen)
DB_PW_VISION=bitte-aendern
DB_PW_CALENDAR=bitte-aendern
DB_PW_MAIL=bitte-aendern
DB_PW_FILES=bitte-aendern
DB_PW_GOOGLE=bitte-aendern
DB_PW_MICROSOFT=bitte-aendern
DB_PW_NAS=bitte-aendern

# --- Netzwerk
# Auf welcher Adresse Web-App, ntfy und MQTT lauschen. 0.0.0.0 = LAN + Tailscale.
# Sicherer: nur die Tailscale-IP der Box eintragen (tailscale ip -4).
BIND_IP=0.0.0.0
# Port der Web-App: 80 ergibt http://qulsi.local (Hostname der Box auf "qulsi" setzen)
QULSI_PORT=80
# Unter dieser Adresse erreicht dein Handy QuLSI (für die Freigabe-Knöpfe), z. B. über Tailscale:
PUBLIC_URL=http://qulsi.local
NTFY_PUBLIC_URL=http://qulsi.local:8090
# Thema und Token setzt scripts/ntfy-einrichten.sh (zufälliges Thema, ntfy lässt ohne Token niemanden rein)
NTFY_TOPIC=qulsi
NTFY_TOKEN=
# Offline-Modus: auto (prüft das Internet), true (immer offline), false (nie)
QULSI_OFFLINE=auto

# --- Modelle (Dateien liegen in ./models, siehe scripts/download-models.sh)
BONSAI_FILE=Ternary-Bonsai-2-27B-PQ2_0.gguf
# Für Bildfragen (vision.analyze) die mmproj-Datei der Modellseite eintragen:
BONSAI_MMPROJ=
# Kontext: 49152 Tokens, KV-Cache in 4 Bit (q4_0). q8_0 ist etwas genauer und braucht doppelt so viel.
BONSAI_CTX=49152
BONSAI_KV=q4_0
# Kleines Modell, Embeddings, Whisper und Vision-Modelle laden bei Bedarf und gehen nach so vielen
# Sekunden ohne Nutzung wieder aus dem Grafikspeicher (-1 bzw. 0 = immer geladen).
KLEIN_SCHLAF_SEKUNDEN=600
EMBED_SCHLAF_SEKUNDEN=600
STT_LEERLAUF_SEKUNDEN=600
MODELL_LEERLAUF_SEKUNDEN=600
BONSAI_PARALLEL=2
KLEIN_FILE=Qwen3-1.7B-Q8_0.gguf
# 0 = kleines Modell auf der CPU (Standard auf der Box: spart ca. 2 GB Grafikspeicher für die Sprachausgabe;
# der Ryzen schafft kurze Befehle schnell genug). 99 = auf der GPU.
KLEIN_GPU_LAYERS=0
# "aus" schaltet das kleine Modell ab, dann übernimmt Bonsai alles
MODEL_SMALL=
EMBED_FILE=Qwen3-Embedding-0.6B-Q8_0.gguf

# --- Voice (Sprache)
STT_PROVIDER=whisper
STT_MODEL=large-v3-turbo
# Sprachausgabe auf der GPU (Dienst tts): qwen3-tts (Standard, ca. 3 GB), cosyvoice3 (ca. 4 GB) oder chatterbox.
# Wechseln: Wert ändern, dann  docker compose build tts && docker compose --profile setup run --rm tts-modell
#           && docker compose --profile box up -d tts
TTS_MODELL=qwen3-tts
# Nur qwen3-tts: eingebauter Sprecher (leer = erster des Modells). Eigene Stimme für alle Modelle:
# config/stimme/stimme.wav (5-15 s, sauber) und config/stimme/stimme.txt (der gesprochene Text).
TTS_SPRECHER=
TTS_LEERLAUF_SEKUNDEN=600
# Fällt der TTS-Dienst aus, spricht Piper (klein, CPU):
TTS_ERSATZ=piper
TTS_VOICE=de_DE-thorsten-high
# TTS_PROVIDER=piper nutzt nur Piper; TTS_PROVIDER=openai mit TTS_URL einen anderen Server mit /v1/audio/speech.
TTS_PROVIDER=openai
TTS_URL=http://tts:8400/v1
WAKEWORD=ok_nabu

# --- Home Assistant
HA_URL=http://host.docker.internal:8123
# Das Zugriffstoken (HA > Profil > Sicherheit > Token erstellen) kommt in den Tresor, nicht hierher:
#   docker compose run --rm tresor setzen HA_TOKEN

# --- Kalender: geheime iCal-Adressen, mehrere mit ; trennen
# CALENDAR_ICS_URLS=Privat=https://calendar.google.com/calendar/ical/.../basic.ics;Arbeit=https://...
CALENDAR_ICS_URLS=
CALENDAR_SYNC_MINUTES=15
# Deine Mailadressen (mit ; getrennt). Termine mit anderem Organisator sind Einladungen von
# Dritten und gelten als fremder Text. Leer = MAIL_FROM.
CALENDAR_EIGENE_ADRESSEN=

# --- Mail (optional)
IMAP_HOST=
IMAP_USER=
# Passwort in den Tresor: docker compose run --rm tresor setzen IMAP_PASSWORD (optional SMTP_PASSWORD)
SMTP_HOST=
SMTP_PORT=587
MAIL_FROM=

# --- Konten (optional, Einrichtung im README, Abschnitt "Konten: Google, Microsoft, NAS, Browser")
# Google: eigener OAuth-Client vom Typ "Desktop-App" (console.cloud.google.com)
GOOGLE_CLIENT_ID=
# Client-Secret in den Tresor: docker compose run --rm tresor setzen GOOGLE_CLIENT_SECRET
# Welche Google-Kalender in den lokalen Cache kommen (Namen mit ; getrennt). Leer = die angehakten.
GOOGLE_CALENDARS=
# Microsoft: App-Registrierung in Entra mit "Öffentliche Clientflows" an
MS_CLIENT_ID=
# common (privat + Arbeit), consumers (nur privat) oder die ID deiner Firma
MS_TENANT=common
# NAS über SMB, nur lesend. Ordner fürs Gedächtnis mit ; getrennt (leer = keine)
NAS_HOST=
NAS_SHARE=
NAS_USER=
# Passwort in den Tresor: docker compose run --rm tresor setzen NAS_PASSWORD
NAS_INDEX_ORDNER=
# Browser: welche Seiten QuLSI öffnen darf. * = jede öffentliche Seite (nie Heimnetz),
# oder enger, z. B. *.wikipedia.org;*.bahn.de
BROWSER_ALLOWED_DOMAINS=*

# --- Dateien, die QuLSI durchsuchen darf (nur lesend)
FILES_DIR=./data/files
# Hochladen aus der App: Fotos landen in FOTOS_DIR/Hochgeladen, Dateien in FILES_DIR/Hochgeladen
# (nur diese Unterordner darf QuLSI beschreiben; scripts/erststart.sh legt sie an). Höchstgröße je Datei:
HOCHLADEN_MAX_MB=25

# --- Gedächtnis
# Fotos (nur lesend): Aufnahmezeit, GPS und Album werden Teil der Timeline
FOTOS_DIR=./data/fotos
# Memchip: austauschbarer Speicher (USB-SSD, SD-Karte) für das ganze Gedächtnis
MEMCHIP_DIR=./data/memchip
# Pflicht für den Memchip: ohne Passwort wird nichts exportiert (AES-256-GCM verschlüsselt).
MEMCHIP_PASSWORT=
# Nur wenn du wirklich ein unverschlüsseltes tar willst: 1
MEMCHIP_UNVERSCHLUESSELT=0
# Alle N Stunden automatisch auf den Chip sichern (0 = aus), die letzten 5 bleiben
MEMCHIP_AUTO_STUNDEN=0
# Wie oft der Organisator Termine, Mails, Fotos und Dateien einsortiert (0 = aus)
ORGANISATOR_MINUTEN=10

# --- Kameras (RTSP-Substream reicht, 640x360 bis 1280x720)
# Live-Kameras sind vorerst aus. Sie laufen nur mit docker-compose.kameras.yml (RunPod: KAMERAS_LIVE=true).
KAMERA_KUECHE_URL=
KAMERA_FLUR_URL=
KAMERA_WOHNZIMMER_URL=
DETECTOR=owlv2   # owlv2 (Apache-2.0, Standard) oder yolo-world (schneller, aber AGPL-Bibliothek ultralytics)
EMBEDDER=siglip
CROP_RETENTION_DAYS=14

# --- Tailscale als Container (optional, Profil "remote")
TS_AUTHKEY=
TS_HOSTNAME=qulsi

# --- Optional Cloud-Modell in config/litellm.yaml
ANTHROPIC_API_KEY=
